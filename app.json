{
  "expo": {
    "name": "Test Real Estate",
    "slug": "rep",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rep",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.rep",
      "infoPlist": {
        "CFBundleDisplayName": "Test Real Estate",
        "LSApplicationQueriesSchemes": ["tel", "mailto"]
      },
      "associatedDomains": [
        "applinks:rep-dev.utspdev.com",
        "applinks:rep-test.utspdev.com",
        "applinks:rep.utspdev.com"
      ],
      "appleTeamId": "85A3D5474J"
    },
    "android": {
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rep-dev.utspdev.com",
              "pathPrefix": "/app/open"
            },
            {
              "scheme": "https",
              "host": "rep-test.utspdev.com",
              "pathPrefix": "/app/open"
            },
            {
              "scheme": "https",
              "host": "rep.utspdev.com",
              "pathPrefix": "/app/open"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rep-dev.utspdev.com",
              "pathPrefix": "/app/open"
            },
            {
              "scheme": "https",
              "host": "rep-test.utspdev.com",
              "pathPrefix": "/app/open"
            },
            {
              "scheme": "https",
              "host": "rep.utspdev.com",
              "pathPrefix": "/app/open"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": ["android.permission.RECORD_AUDIO"],
      "package": "com.anonymous.rep"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload documents and images.",
          "cameraPermission": "The app accesses your camera to let you take and upload photos."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
